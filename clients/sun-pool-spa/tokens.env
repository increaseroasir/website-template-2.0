# Verified Cloudflare Pages deployment bindings (2026-07-25)
CAMPAIGN_NAME=sun-pool-spa-website
CLOUDFLARE_PAGES_PROJECT=sun-pool-spa
D1_DATABASE_NAME=sun-pool-spa-inventory
D1_DATABASE_ID=dda51296-4f24-45b9-970b-32c3d2252665
R2_BUCKET_NAME=sun-pool-spa-product-images
ALLOWED_ORIGIN=https://sunpoolandspasupply.com
# Public R2 delivery verified 2026-07-29 — bucket public access enabled and a
# product image confirmed serving 200. The UNCONFIGURED sentinel now blocks admin
# uploads by design (WTV-056), so leaving it set would fail-closed on every upload.
R2_PUBLIC_BUCKET_ID=24055549503540b0b5ff19237b87d146

# Sun Pool carries no saunas, so the sauna nav slot points at the match quiz
# (TVD-052). /saunas/ 301s to /quiz/ via redirects.extra.
SAUNAS_URL=/quiz/
SAUNAS_NAV_LABEL="Find Your Match"

# Footer blurb is one token across all 12 pages. Seven of them used to hardcode a
# sentence promising saunas, which this dealer does not stock.
FOOTER_BLURB="Family-owned in Lakeside for 47 years, with real units on the floor and a team that is here after the sale."

# Hard-required homepage image tokens (recovered from production hydrate c9826dc3)
HOT_TUBS_CATEGORY_IMAGE="/assets/HOTTUBS_sun-pool-spa-six-person-hot-tub.webp"
