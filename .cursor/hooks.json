{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "type": "command",
        "command": "node .cursor/hooks/factory-safety-shell.mjs",
        "failClosed": true,
        "timeout": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": "node .cursor/hooks/factory-safety-pretool.mjs",
        "failClosed": true,
        "timeout": 30,
        "matcher": "Write|Delete|Edit|StrReplace|EditNotebook"
      }
    ]
  }
}
