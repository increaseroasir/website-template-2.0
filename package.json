{
  "name": "hot-tub-dealer-site-template",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "brand:guard": "node scripts/check-template-guard.mjs",
    "client:new": "node manus-skills/dealer-site-intake/scripts/new-client.mjs",
    "client:validate": "node manus-skills/dealer-site-intake/scripts/new-client.mjs",
    "client:gate": "node manus-skills/dealer-site-launch/scripts/gate.mjs",
    "build:config": "node scripts/build-config.mjs",
    "placeholder:check": "node scripts/scan-placeholders.mjs --launch",
    "launch:check": "node scripts/launch-check.mjs",
    "admin:smoke": "node scripts/admin-inventory-smoke.mjs",
    "ghl:fields:check": "node scripts/verify-ghl-fields.mjs",
    "ghl:fields:create": "node scripts/verify-ghl-fields.mjs --create",
    "secrets:verify": "node scripts/verify-runtime-secrets.mjs",
    "verify:cards": "node scripts/verify-card-status.mjs",
    "check:tokens": "node scripts/check-tokens-env.mjs",
    "db:init:local": "wrangler d1 execute DB --local --file=functions/db/schema.sql",
    "db:init:remote": "wrangler d1 execute DB --remote --file=functions/db/schema.sql",
    "leads:reimport-missed": "node scripts/reimport-missed-leads.mjs",
    "ga4:funnel": "node scripts/ga4-funnel-report.mjs",
    "fulfillment:check": "node scripts/check-fulfillment-artifacts.mjs",
    "deploy": "npm run brand:guard && npm run build:config && npm run launch:check && wrangler pages deploy . --project-name {{CLOUDFLARE_PAGES_PROJECT}} --branch main",
    "preview:deploy": "npm run brand:guard && npm run build:config && npm run placeholder:check && wrangler pages deploy . --project-name {{CLOUDFLARE_PAGES_PROJECT}} --branch preview",
    "lh:mobile": "node scripts/lighthouse-check.mjs",
    "lh:desktop": "node scripts/lighthouse-check.mjs --desktop",
    "psi:mobile": "node scripts/psi-check.mjs",
    "psi:desktop": "node scripts/psi-check.mjs --desktop",
    "images:optimize": "node scripts/optimize-images.mjs",
    "test": "node --test tests/safety/*.test.mjs",
    "test:safety": "node scripts/check-safety.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "wrangler": "latest"
  }
}
